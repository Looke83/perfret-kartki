---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// 1. Definiujemy dozwolone foldery
type FolderType = "cards" | "ecards" | "personalized";

interface Props {
  id: string;
  folder: FolderType;
  title: string;
}

const { id, folder, title } = Astro.props;

// 2. Słownik prefiksów – tu możesz łatwo dopisać kolejną opcję
const folderPrefixes: Record<FolderType, string> = {
  cards: "Kartka",
  ecards: "E-kartka",
};

const prefix = folderPrefixes[folder] ?? "";

// 3. Glob z wszystkimi obsługiwanymi folderami
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/{cards,ecards}/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

const matchingEntries = Object.entries(allImages).filter(([path]) =>
  path.includes(`/src/assets/${folder}/`),
);

const cards = await Promise.all(
  matchingEntries.map(async ([path, mod]) => {
    const rawImage = mod.default;
    const fileName =
      path
        .split("/")
        .pop()
        ?.replace(/\.[^/.]+$/, "") ?? "";

    const displayTitle =
      fileName.length >= 7 ? fileName.substring(4, 7) : fileName;

    const fullImage = await getImage({
      src: rawImage,
      width: 1600,
      format: "webp",
    });

    return {
      title: displayTitle,
      thumb: rawImage,
      fullSrc: fullImage.src,
      width: fullImage.attributes.width,
      height: fullImage.attributes.height,
    };
  }),
);
---

<section id={id} class="site-wrapper py-10">
  <!-- Pasek nagłówkowy dokładnie jak na szkicu PDF -->
  <div class="mb-8 pb-4 border-b border-neutral-300/70 text-center">
    <h2 class="text-(length:--text-step-2) font-black text-neutral-900">
      {title}
    </h2>
  </div>

  <!-- Siatka miniaturek z Lightboxem -->
  <div
    id={`grid-${id}`}
    class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4"
  >
    {
      cards.map((card, index) => (
        <a
          href={card.fullSrc}
          data-pswp-width={card.width}
          data-pswp-height={card.height}
          class="group block bg-white rounded-xl p-2 border border-neutral-200/90 shadow-2xs hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-zoom-in"
        >
          <div class="aspect-3/4 w-full overflow-hidden rounded-lg bg-neutral-100">
            <Image
              src={card.thumb}
              alt={card.title}
              width={500}
              quality={80}
              format="webp"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-103"
              loading={index < 8 ? "eager" : "lazy"}
            />
          </div>
          <div class="mt-2 text-center">
            <span class="text-xs font-semibold text-neutral-600 uppercase tracking-wider">
              {prefix} - {card.title}
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  function initGalleries() {
    // Inicjalizujemy wszystkie kontenery galerii na stronie
    const galleryElements = document.querySelectorAll('[id^="grid-"]');

    galleryElements.forEach((galleryEl) => {
      const lightbox = new PhotoSwipeLightbox({
        gallery: galleryEl as HTMLElement,
        children: "a",
        pswpModule: () => import("photoswipe"),
        showHideAnimationType: "zoom",
        // Wyłączamy domyślne otwieranie linku
        wheelToZoom: true,
      });

      lightbox.init();
    });
  }

  // Uruchomienie przy pierwszym załadowaniu strony
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGalleries);
  } else {
    initGalleries();
  }

  // Obsługa ewentualnego Astro View Transitions
  document.addEventListener("astro:page-load", initGalleries);
</script>
