---
import ikonaKrok1 from "../assets/svg/ikona-wybierz-wzor.svg";
import ikonaKrok2 from "../assets/svg/ikona-przeslij-logo-i-zyczenia.svg";
import ikonaKrok3 from "../assets/svg/ikona-otrzymaj-darmowa-wizualizacje.svg";
import ikonaKrok4 from "../assets/svg/ikona-zamow-kartke.svg";

// Przyciski SVG dokładnie jak w HeroTwoColumns
import buttEcard from "../assets/svg/butt_ecard.svg";
import buttDruk from "../assets/svg/butt_druk.svg";

const steps = [
  { src: ikonaKrok1.src, alt: "Krok 1: Wybierz wzór" },
  { src: ikonaKrok2.src, alt: "Krok 2: Prześlij logo i życzenia" },
  { src: ikonaKrok3.src, alt: "Krok 3: Otrzymaj darmową wizualizację" },
  {
    src: ikonaKrok4.src,
    alt: "Krok 4: Po akceptacji wzoru zamów i zapłać za kartkę",
  },
];
---

<section id="proces" class="w-full">
  <div class="site-wrapper flex flex-col items-center">
    <!-- Nagłówek i podtytuł sekcji 
    <div class="text-center mb-10 lg:mb-12">
      <h2
        class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-[#0d5358] mb-3"
      >
        Jak zamówić kartki świąteczne?
      </h2>
      <p
        class="text-xs sm:text-sm font-bold tracking-widest text-[#0d5358]/80 uppercase"
      >
        Prosty i przejrzysty proces w 4 szybkich krokach
      </p>
    </div>-->

    <!-- Siatka 4 kroków: 2 na mobile, 4 na desktopie -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 lg:gap-12 items-start justify-items-center w-full"
    >
      {
        steps.map((step) => (
          <div class="flex flex-col items-center justify-center w-full group">
            <img
              src={step.src}
              alt={step.alt}
              class="w-32 sm:w-36 lg:w-44 h-auto object-contain transition-transform duration-300 group-hover:scale-105 drop-shadow-2xs"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
  <!-- Przyciski z odnośnikami do galerii (jak w HeroTwoColumns) -->
  <div
    class="mt-12 lg:mt-16 flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-16 lg:gap-24 w-full"
  >
    <!-- Przycisk E-kartki -->
    <a
      href="/e-kartki"
      class="group inline-block transition-transform duration-300 hover:scale-103 active:scale-95 cursor-pointer"
    >
      <img
        src={buttEcard.src}
        alt="Zobacz galerię i zamów e-kartkę"
        class="h-11 sm:h-12 w-auto object-contain transition-all duration-300 group-hover:drop-shadow-md"
      />
    </a>

    <!-- Przycisk Kartki drukowane -->
    <a
      href="/kartki-drukowane"
      class="group inline-block transition-transform duration-300 hover:scale-103 active:scale-95 cursor-pointer"
    >
      <img
        src={buttDruk.src}
        alt="Zobacz galerię i zamów kartkę drukowaną"
        class="h-11 sm:h-12 w-auto object-contain transition-all duration-300 group-hover:drop-shadow-md"
      />
    </a>
  </div>
</section>
