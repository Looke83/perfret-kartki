<footer
  id="kontakt"
  class="bg-neutral-900 text-white mt-auto py-(--spacing-space-2xl) border-t border-neutral-800"
>
  <div
    class="site-wrapper flex flex-col md:flex-row items-center justify-between gap-(--spacing-space-m)"
  >
    <div>
      <p class="text-(length:--text-step-1) font-black tracking-tight">
        perFRET <span class="text-primary font-normal">DESIGN</span>
      </p>
      <p class="text-(length:--text-step--1) text-neutral-400 mt-1">
        Elektroniczne kartki świąteczne dla firm i instytucji.
      </p>
    </div>

    <div
      class="flex flex-col sm:flex-row items-center gap-6 text-(length:--text-step--1) text-neutral-300"
    >
      <a
        href="mailto:kontakt@perfret.pl"
        class="hover:text-white transition-colors"
      >
        kontakt@perfret.pl
      </a>
      <a href="tel:+48000000000" class="hover:text-white transition-colors">
        +48 000 000 000
      </a>
    </div>
  </div>

  <div
    class="site-wrapper mt-(--spacing-space-l) pt-(--spacing-space-s) border-t border-neutral-800 text-center text-(length:--text-step--2) text-neutral-500"
  >
    &copy; {new Date().getFullYear()} perFRET DESIGN. Wszelkie prawa zastrzeżone.
  </div>
</footer>
