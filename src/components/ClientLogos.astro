---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/clients/*.{svg,png,jpg,jpeg,webp}",
  { eager: true },
);

const logos = Object.values(logoFiles).map((file) => file.default);
---

<section class="w-full flex flex-col items-center pb-6">
  <!-- Nagłówek sekcji umieszczony na samej górze -->
  <div class="text-center mb-6 sm:mb-8">
    <h2 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-[#0d5358]">
      Zaufali nam:
    </h2>
  </div>

  <!-- Kontener z maską gradientową i własną sztywną wysokością -->
  <div
    class="relative w-full h-24 lg:h-28 flex items-center overflow-hidden marquee-container"
  >
    <!-- Pętla przesuwna wycentrowana w pionie -->
    <div
      class="flex w-max items-center h-full marquee-track hover:[animation-play-state:paused]"
    >
      <!-- Grupa 1 -->
      <div
        class="flex items-center gap-12 sm:gap-16 lg:gap-20 shrink-0 px-6 sm:px-10 h-full"
      >
        {
          logos.map((logo) => (
            <div class="flex items-center justify-center shrink-0 w-auto min-w-[140px] max-w-[200px] h-full">
              <Image
                src={logo}
                alt="Logotyp klienta"
                height={80}
                format="webp"
                class="max-h-12 sm:max-h-14 lg:max-h-16 w-auto object-contain opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300"
              />
            </div>
          ))
        }
      </div>

      <!-- Grupa 2 (duplikat) -->
      <div
        class="flex items-center gap-12 sm:gap-16 lg:gap-20 shrink-0 px-6 sm:px-10 h-full"
        aria-hidden="true"
      >
        {
          logos.map((logo) => (
            <div class="flex items-center justify-center shrink-0 w-auto min-w-[140px] max-w-[200px] h-full">
              <Image
                src={logo}
                alt=""
                height={80}
                format="webp"
                class="max-h-12 sm:max-h-14 lg:max-h-16 w-auto object-contain opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-container {
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12%,
      rgba(0, 0, 0, 1) 88%,
      rgba(0, 0, 0, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12%,
      rgba(0, 0, 0, 1) 88%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .marquee-track {
    animation: scroll-marquee 35s linear infinite;
  }

  @keyframes scroll-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
