---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Process from "../components/Process.astro";
import FeaturesBarCardAlone from "./FeaturesBarCardAlone.astro";
import CardsChange from "./CardsChange.astro";

// Automatyczne pobranie wszystkich grafik z folderu realizations
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/realcard/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

// Przygotowanie miniaturek i pełnych ścieżek pod ewentualny PhotoSwipe
const items = await Promise.all(
  Object.values(allImages).map(async (mod) => {
    const rawImage = mod.default;
    const fullImage = await getImage({
      src: rawImage,
      width: 1600,
      format: "webp",
    });

    return {
      thumb: rawImage,
      fullSrc: fullImage.src,
      width: fullImage.attributes.width,
      height: fullImage.attributes.height,
    };
  }),
);
---

<section id="realizacje" class="">
  <div class="site-wrapper flex flex-col items-center">
    <!-- Nagłówek i podtytuł sekcji -->
    <div class="text-center mb-10 lg:mb-12">
      <h2
        class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-[#0d5358] mb-3"
      >
        Drukowane kartki świąteczne dla firm
      </h2>
      <FeaturesBarCardAlone />
    </div>
    <CardsChange />

    <!-- Siatka realizacji: 2 na wiersz w identycznym stylu i rozmiarze co w sekcji Personalizacja -->
    <div
      id="grid-realizacje"
      class="grid grid-cols-2 md:grid-cols-3 gap-6 lg:gap-12 items-center justify-items-center w-full"
    >
      {
        items.map((item, index) => (
          <a
            href={item.fullSrc}
            data-pswp-width={item.width}
            data-pswp-height={item.height}
            class="w-full flex justify-center cursor-zoom-in"
          >
            <Image
              src={item.thumb}
              alt="Przykładowa realizacja"
              width={1200}
              format="webp"
              class="w-full max-w-sm sm:max-w-md h-auto object-contain drop-shadow-md transition-transform duration-300 hover:scale-102"
              loading={index < 4 ? "eager" : "lazy"}
            />
          </a>
        ))
      }
    </div>
  </div>
  <!-- <Process /> -->
</section>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  function initRealizationsLightbox() {
    const galleryEl = document.getElementById("grid-realizacje");
    if (!galleryEl) return;

    const lightbox = new PhotoSwipeLightbox({
      gallery: galleryEl,
      children: "a",
      pswpModule: () => import("photoswipe"),
      showHideAnimationType: "zoom",
      wheelToZoom: true,
    });

    lightbox.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRealizationsLightbox);
  } else {
    initRealizationsLightbox();
  }

  document.addEventListener("astro:page-load", initRealizationsLightbox);
</script>
