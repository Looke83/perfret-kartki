---
import plFlag from "../assets/svg/pl.svg";
import engFlag from "../assets/svg/eng.svg";
import deFlag from "../assets/svg/de.svg";

const wishes = [
  {
    flag: plFlag,
    alt: "Język polski",
    text: "Wszystkim Klientom, Partnerom oraz Sympatykom naszej Firmy składamy życzenia spokojnych i radosnych Świąt Bożego Narodzenia oraz pomyślności i sukcesów w Nowym Roku",
  },
  {
    flag: engFlag,
    alt: "Język angielski",
    text: "We would like to wish all our Customers, Partners and Friends a peaceful and joyous Christmas, and success and prosperity in the New Year",
  },
  {
    flag: deFlag,
    alt: "Język niemiecki",
    text: "Wir wünschen allen Kunden, Partnern und Freunden unseres Unternehmens ein friedliches und fröhliches Weihnachtsfest sowie Wohlstand und Erfolg im neuen Jahr.",
  },
];
---

<section id="zyczenia" class="w-full bg-[#edf2f6] border-y border-neutral-200/70">
  <div class="site-wrapper flex flex-col items-center">
    
    <!-- Czerwony akcent dekoracyjny nad tytułem -->
    <div class="w-12 h-0.5 bg-[#e31e24] mb-5"></div>

    <!-- Nagłówek i podtytuł -->
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-medium tracking-tight text-[#0d5358] mb-3">
        Życzenia do wyboru w 3 językach
      </h2>
      <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#0d5358]/80 uppercase">
        Mogą być też dowolne przesłane przez Ciebie
      </p>
    </div>

    <!-- Siatka 3 kolumn z pionowymi separatorami -->
    <div class="grid grid-cols-1 md:grid-cols-3 w-full max-w-6xl gap-10 md:gap-0 items-stretch mb-16 sm:mt-20">
      {
        wishes.map((item, index) => (
          <div
            class:list={[
              "flex flex-col items-center text-center px-4 sm:px-8 lg:px-12",
              index > 0 && "md:border-l md:border-[#2d7387]/50",
            ]}
          >
            <!-- Flaga -->
            <div class="h-10 mb-8 flex items-center justify-center">
              <img
                src={item.flag.src}
                alt={item.alt}
                class="h-8 w-auto rounded-xs shadow-xs object-contain"
              />
            </div>

            <!-- Treść życzeń (elegancka kursywa Cormorant) -->
            <p class="font-serif italic text-base sm:text-lg lg:text-[1.15rem] leading-relaxed text-[#0d5358]/95 max-w-sm">
              {item.text}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Dolna belka nawigacyjna z liniami po bokach -->
    
    
    

  </div>
</section>