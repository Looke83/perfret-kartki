---
const features = [
  {
    number: "100+",
    subNumber: "WZORÓW",
    
  },
  {
    number: "100+",
    subNumber: "DARMOWA WIZUALIZCJA",
    
  },
  {
    number: "100+",
    subNumber: "BEZPŁATNE POPRAWKI",
    
  },
  {
    number: "100+",
    subNumber: "KOPERTY GRATIS",
    
  },
];
---


  <div class="grid grid-cols-4 lg:grid-cols-4 gap-6 lg:gap-8 items-center pb-6 border-b border-[#2d7387]/60">
    {features.map((item) => (
      <div class="flex items-center gap-3">
        <!-- Liczba z dopiskiem pod spodem -->
        <div class="flex flex-col items-center shrink-0 min-w-[54px] text-center">
          <span class="text-3xl lg:text-4xl font-light tracking-tight text-[#165b6f] leading-none">
            {item.number}
          </span>
          <span class="text-[9px] sm:text-[10px] font-bold tracking-widest text-[#165b6f] uppercase mt-1.5 leading-tight max-w-[110px]">
            {item.subNumber}
          </span>
        </div>

        
      
      </div>
    ))}
  </div>
