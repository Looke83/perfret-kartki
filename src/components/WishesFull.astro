---

<section id="zyczenia" class="w-full bg-[#edf2f6] border-y border-neutral-200/70 pb-20">
  <div class="site-wrapper flex flex-col items-center">
    
    <!-- Czerwony akcent dekoracyjny nad tytułem[cite: 3] -->
    <div class="w-12 h-0.5 bg-[#e31e24] mb-5"></div>

    <!-- Nagłówek i podtytuł[cite: 3] -->
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-medium tracking-tight text-[#0d5358] mb-3">
        Życzenia do wyboru w 3 językach
      </h2>
      <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#0d5358]/80 uppercase">
        Mogą być też dowolne przesłane przez Ciebie
      </p>
    </div>

    <!-- Lista 11 wierszy z zachowaniem separatorów i kolumn[cite: 3, 4] -->
    <div class="w-full max-w-6xl flex flex-col gap-20 sm:mt-10">
      {
        wishSets.map((set) => (
          <div class="flex flex-col md:flex-row items-center w-full">
            
<!-- Duża normalna cyfra (arabska) z wyraźnym daszkiem -->
            <div class="w-full md:w-32 shrink-0 flex items-center justify-center md:justify-start select-none pointer-events-none mb-6 md:mb-0">
              <span 
                class="font-sans font-extrabold leading-none"
                style="font-family: Arial, Helvetica, sans-serif; font-size: clamp(4.5rem, 10vw, 8rem); color: #0d5358; opacity: 0.16;"
              >
                {set.id}
              </span>
            </div>

            <!-- Siatka 3 kolumn życzeń z pionowymi separatorami[cite: 3] -->
            <div class="grid grid-cols-1 md:grid-cols-3 flex-1 w-full gap-10 md:gap-0 items-stretch">
              {
                set.items.map((item, index) => (
                  <div
                    class:list={[
                      "flex flex-col items-center text-center px-4 sm:px-8 lg:px-12",
                      index > 0 && "md:border-l md:border-[#2d7387]/50",
                    ]}
                  >
                    <!-- Flaga[cite: 3] -->
                    <div class="h-10 mb-8 flex items-center justify-center">
                      <img
                        src={item.flag.src}
                        alt={item.alt}
                        class="h-8 w-auto rounded-xs shadow-xs object-contain"
                      />
                    </div>

                    <!-- Treść życzeń[cite: 3] -->
                    <p class="font-serif italic text-base sm:text-lg lg:text-[1.15rem] leading-relaxed text-[#0d5358]/95 max-w-sm">
                      {item.text}
                    </p>
                  </div>
                ))
              }
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>