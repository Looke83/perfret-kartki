---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "perFRET DESIGN | Elektroniczne kartki świąteczne dla firm",
  description = "Elektroniczne kartki świąteczne dla firm. Ponad 100 gotowych wzorów z Twoim logo i życzeniami. Realizacja w maksymalnie 24h. Sprawdź katalog i zamów bezpłatną wizualizację.",
  image = "/og-image.jpg",
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : "https://kartki.perfret.pl";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Elektroniczne kartki świąteczne dla firm",
  description: description,
  brand: {
    "@type": "Brand",
    name: "perFRET DESIGN",
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "PLN",
    availability: "https://schema.org/InStock",
  },
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    <meta property="og:locale" content="pl_PL" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl)} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body
    class="min-h-screen flex flex-col bg-surface text-body antialiased selection:bg-primary/20 selection:text-primary"
  >
    <slot />
  </body>
</html>
