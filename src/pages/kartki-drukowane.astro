---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeaderBannerCard from "../components/HeaderBannerCard.astro";
import CardsGallery from "../components/CardsGallery.astro";
import Footer from "../components/Footer.astro";

import Wishes from "../components/Wishes.astro";

import PricingEcards from "../components/PricingEcards.astro";
import RealizationsCard from "../components/RealizationsCard.astro";
---

<Layout title="Drukowane kartki świąteczne dla firm - perFRET DESIGN">
  <Header />

  <main class="flex flex-col gap-16 md:gap-24 lg:gap-32">
    <HeaderBannerCard />
    <RealizationsCard />
    <CardsGallery
      id="e-kartki"
      folder="cards"
      title="Wzory kartek świątecznych do wyboru:"
    />

    <Wishes />
    <!-- <ClientLogos /> -->
    <PricingEcards
      id="cennik"
      topBadges={[
        { text: "Darmowa wizualizacja" },
        { text: "Bezpłatne poprawki" },
        { text: "Szybka realizacja" },
      ]}
    />
    <!-- <Personalization /> -->
  </main>

  <Footer />
</Layout>
