---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeaderBanner from "../components/HeaderBanner.astro";
import HeroTwoColumns from "../components/HeroTwoColumns.astro";
import Personalization from "../components/Personalization.astro";
import Wishes from "../components/Wishes.astro";
import ClientLogos from "../components/ClientLogos.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />

  <!-- Duże sekcje z dużym oddechem -->
  <main class="flex flex-col gap-20 md:gap-32 lg:gap-40">
    <HeaderBanner />
    <HeroTwoColumns />
    <Personalization />
    <Wishes />
  </main>

  <!-- Pasek logotypów wypośrodkowany idealnie między Wishes a stopką -->
  <div class="my-12 md:my-16 lg:my-20">
    <ClientLogos />
  </div>

  <!-- Stopka bez marginesu górnego (odstęp daje jej my-... z wrappera powyżej) -->
  <Footer />
</Layout>
